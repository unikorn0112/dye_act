<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>染織文化協會手作體驗報名</title>
    <style>
        :root {
            --primary-color: #2E4F36; /* 沉穩森林綠 */
            --accent-color: #D36B40; /* 暖橘項目金額 */
            --bg-color: #F4F6F4; 
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            margin: 0;
            padding: 15px;
            color: #333;
        }
        .container {
            max-width: 480px;
            background: #ffffff;
            margin: 10px auto;
            padding: 24px;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        }
        h2 {
            text-align: center;
            color: var(--primary-color);
            margin-bottom: 5px;
            font-size: 24px;
        }
        .subtitle {
            text-align: center;
            color: #666;
            font-size: 14px;
            margin-bottom: 25px;
        }
        .form-group {
            margin-bottom: 18px;
        }
        label {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
            color: #444;
            font-size: 15px;
        }
        select, input[type="text"], input[type="tel"], textarea {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 16px;
            background-color: #FAFAFA;
        }
        select:focus, input:focus {
            border-color: var(--primary-color);
            background-color: #fff;
            outline: none;
        }
        .radio-group {
            display: flex;
            gap: 20px;
            margin-top: 5px;
        }
        .radio-label {
            display: flex;
            align-items: center;
            font-weight: normal;
            cursor: pointer;
        }
        .radio-label input {
            margin-right: 6px;
            transform: scale(1.1);
        }
        .fee-display {
            background-color: #F0F4F1;
            padding: 14px;
            border-radius: 8px;
            font-size: 20px;
            font-weight: bold;
            color: var(--accent-color);
            border-left: 5px solid var(--primary-color);
        }
        .hidden {
            display: none;
        }
        button {
            width: 100%;
            padding: 14px;
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s;
            margin-top: 10px;
        }
        button:hover {
            background-color: #1F3725;
        }
        button:disabled {
            background-color: #ccc;
            cursor: not-allowed;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>染織文化協會</h2>
    <div class="subtitle">6/28 限時手作體驗課線上報名</div>
    
    <form id="regForm">
        <!-- 1. 選擇活動 -->
        <div class="form-group">
            <label>1. 選擇活動項目</label>
            <select id="activity" required>
                <option value="">-- 請選擇體驗項目 --</option>
                <option value="lipbalm">植萃香遇・護唇膏 DIY</option>
                <option value="socks">植物染襪手作體驗</option>
            </select>
        </div>

        <!-- 2. 活動場次 (自動連動) -->
        <div class="form-group">
            <label>2. 活動場次時間</label>
            <select id="session" required disabled>
                <option value="">-- 請先選擇活動項目 --</option>
            </select>
        </div>

        <!-- 3. 身分確認 (僅選植物染襪時會動態出現) -->
        <div id="identityGroup" class="form-group hidden">
            <label>3. 您的身分確認</label>
            <div class="radio-group">
                <label class="radio-label"><input type="radio" name="identity" value="nonmember" checked> 非會員</label>
                <label class="radio-label"><input type="radio" name="identity" value="member"> 協會會員</label>
            </div>
        </div>

        <!-- 4. 活動費用 (自動連動計算) -->
        <div class="form-group">
            <label>4. 本場次費用 (當天現場繳費)</label>
            <div id="feeDisplay" class="fee-display">NT$ 0</div>
        </div>

        <hr style="border: 0; border-top: 1px solid #eee; margin: 25px 0;">

        <!-- 基本資料填寫區 -->
        <div class="form-group">
            <label>5. 報名姓名</label>
            <input type="text" id="name" placeholder="請輸入真實姓名" required>
        </div>

        <div class="form-group">
            <label>6. 報名電話</label>
            <input type="tel" id="phone" placeholder="請輸入手機號碼" required pattern="[0-9]{9,10}">
        </div>

        <div class="form-group">
            <label>7. LINE ID</label>
            <input type="text" id="lineId" placeholder="請輸入 LINE ID (選填)">
        </div>

        <div class="form-group">
            <label>8. 備註說明</label>
            <textarea id="note" rows="3" placeholder="如有特殊需求請註明於此..."></textarea>
        </div>

        <button type="submit" id="submitBtn">提交報名資料</button>
    </form>
</div>

<script>
    // ⚠️ 請在此處替換成您在 Google 部署得到的 Web App API 網址
    const GAS_URL = "YOUR_GAS_WEB_APP_URL"; 

    const activitySelect = document.getElementById('activity');
    const sessionSelect = document.getElementById('session');
    const identityGroup = document.getElementById('identityGroup');
    const feeDisplay = document.getElementById('feeDisplay');
    const regForm = document.getElementById('regForm');
    const submitBtn = document.getElementById('submitBtn');

    // 6/28 方案A 指定時間場次資料庫
    const sessionData = {
        lipbalm: [{ text: "6/28 (日) 10:00 - 12:00 (上午場)", value: "6/28 上午場" }],
        socks: [{ text: "6/28 (日) 14:00 - 16:00 (下午場)", value: "6/28 下午場" }]
    };

    // 表單連動事件監聽
    activitySelect.addEventListener('change', updateForm);
    document.querySelectorAll('input[name="identity"]').forEach(radio => {
        radio.addEventListener('change', calculateFee);
    });

    function updateForm() {
        const act = activitySelect.value;
        sessionSelect.innerHTML = "";
        
        if (!act) {
            sessionSelect.disabled = true;
            sessionSelect.innerHTML = '<option value="">-- 請先選擇活動項目 --</option>';
            identityGroup.classList.add('hidden');
            feeDisplay.innerText = "NT$ 0";
            return;
        }

        sessionSelect.disabled = false;
        sessionData[act].forEach(item => {
            let opt = document.createElement('option');
            opt.value = item.value;
            opt.innerText = item.text;
            sessionSelect.appendChild(opt);
        });

        if (act === 'socks') {
            identityGroup.classList.remove('hidden');
        } else {
            identityGroup.classList.add('hidden');
        }
        
        calculateFee();
    }

    function calculateFee() {
        const act = activitySelect.value;
        if (act === 'lipbalm') {
            feeDisplay.innerText = "520";
        } else if (act === 'socks') {
            const isMember = document.querySelector('input[name="identity"]:checked').value === 'member';
            feeDisplay.innerText = isMember ? "250" : "350";
        }
    }

    // 點擊提交
    regForm.addEventListener('submit', function(e) {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.innerText = "正在為您開票中...";

        // 資料乾淨化整理
        let cleanActivityName = "植萃香遇・護唇膏 DIY";
        if (activitySelect.value === 'socks') {
            cleanActivityName = "植物染襪手作體驗";
        }

        const payload = {
            activity: cleanActivityName,
            session: sessionSelect.value,
            identity: activitySelect.value === 'socks' ? (document.querySelector('input[name="identity"]:checked').value === 'member' ? "會員" : "非會員") : "一般",
            fee: feeDisplay.innerText,
            name: document.getElementById('name').value,
            phone: document.getElementById('phone').value,
            lineId: document.getElementById('lineId').value,
            note: document.getElementById('note').value
        };

        // 發送給後端 GAS
        fetch(GAS_URL, {
            method: 'POST',
            mode: 'no-cors', 
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(() => {
            alert('報名成功！期待您的參與。');
            regForm.reset();
            updateForm();
            submitBtn.disabled = false;
            submitBtn.innerText = "提交報名資料";
        })
        .catch(error => {
            alert('報名系統繁忙，請檢查網路連線。');
            console.error('Error:', error);
            submitBtn.disabled = false;
            submitBtn.innerText = "提交報名資料";
        });
    });
</script>

</body>
</html>
